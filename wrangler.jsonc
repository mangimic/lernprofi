// Cloudflare-Worker-Konfiguration: statische Assets aus dist/ +
// Tresor-Sync-API (/api/*) im Worker (server/index.js).
// Keine Secrets hier ablegen!
{
  "name": "lernprofi",
  "compatibility_date": "2026-10-01",
  "main": "server/index.js",
  // KI (Etappe 7): Schlüssel NIE hier eintragen, sondern einmalig als Secret:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  // Optional: "vars": { "KI_DECKEL_MAX_CENT": "1000" }
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // ☁️ KV-Namespace „lernprofi-tresor": Tresor-Sync + KI-Kostenzähler.
  "kv_namespaces": [{ "binding": "TRESOR", "id": "c9f78f3652c046b1a2b6cc18635f5676" }]
}
